{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "braintail",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "braintail.ai/*", "zone_name": "braintail.ai" },
    { "pattern": "www.braintail.ai/*", "zone_name": "braintail.ai" }
  ]
}
